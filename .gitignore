# Ignore directories generated by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/
/web/private/scripts/quicksilver

# Ignore scaffold files
/.editorconfig
/.gitattributes

# Pantheon drush lock
/.drush-lock-update

# Ignore .gitignore files placed by drupal/core-composer-scaffold
/web/**/.gitignore

# Pantheon commits a settings.php for environment-specific settings.
# Place local settings in settings.local.php
/web/sites/*/settings.local.php

# Ignore paths that contain user-generated content.
/web/sites/*/files
/web/sites/*/private

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Include Drupal settings files
!/web/sites/*/settings.php
!/web/sites/*/services.yml

# Frontend (deployed separately)
/frontend

# Recipes are installed via Composer
/recipes/*

# Composer lock (template project — each site generates its own)
composer.lock

# Allow using local config, version dist file.
phpcs.xml
phpunit.xml
.phpunit.result.cache

# Ignore files generated by PhpStorm
.idea/

# Ignore sensitive files
.env

# OS generated files
.DS_Store*
Thumbbs.db

# DDEV overrides
.ddev/docker-compose.host-docker-internal.yaml
.ddev/docker-compose.xdebug-ip.yaml
.ddev/config.fqdns.yaml
.ddev/config.gitpod-overrides.yaml
.ddev/config.devcontainer.yaml
